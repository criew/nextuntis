# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nextuntis
DB_USER=nextuntis
DB_PASSWORD=nextuntis

# Backend
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# Auth (Keycloak OIDC)
OIDC_ISSUER_URI=http://localhost:8180/realms/nextuntis
OIDC_CLIENT_ID=nextuntis-frontend

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Frontend
VITE_API_BASE_URL=http://localhost:8081
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/nextuntis
VITE_OIDC_CLIENT_ID=nextuntis-frontend
